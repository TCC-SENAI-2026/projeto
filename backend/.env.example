# Modelo sem segredos. A configuração local será feita na etapa C.
APP_ENV=development
# Gere uma chave aleatória local; em produção são exigidos >=32 caracteres.
SECRET_KEY=
FRONTEND_ORIGIN=http://localhost:5173
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ethreads_db
DB_POOL_SIZE=5
DB_CONNECT_TIMEOUT=5

# Integrações futuras da equipe (não utilizadas no login).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
