# Copie este arquivo para backend/.env e preencha os valores locais.
# Não coloque credenciais reais neste exemplo nem versione backend/.env.
APP_ENV=development
# Gere uma chave aleatória local; em produção são exigidos >=32 caracteres.
SECRET_KEY=
FRONTEND_ORIGIN=http://localhost:5173
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ethreads_db
DB_POOL_SIZE=5
DB_CONNECT_TIMEOUT=5

# E-mail de desenvolvimento: Mailtrap Email Sandbox.
# A Sandbox captura e-mails de ativação e redefinição para testes;
# eles aparecem na caixa do Mailtrap, não na caixa real do destinatário.
# 1. Acesse Email Sandbox no Mailtrap e selecione/crie uma caixa de testes.
# 2. Na integração SMTP da caixa, copie Username e Password para os campos
#    SMTP_USER e SMTP_PASS abaixo. Não use a senha de login da conta Mailtrap
#    nem um token da API no lugar dessas credenciais SMTP.
# 3. Reinicie o backend após alterar backend/.env.
# 4. Solicite uma ativação/redefinição pelo sistema e confira a caixa no Mailtrap.
# Guia oficial: https://docs.mailtrap.io/email-sandbox/setup/sandbox-smtp-integration
SMTP_HOST=sandbox.smtp.mailtrap.io
# O código usa SMTP com STARTTLS. Use 587 ou 2525 conforme a integração;
# não use 465 neste fluxo, pois ela exige conexão SMTP_SSL.
SMTP_PORT=587
SMTP_USER=
# O serviço atual lê SMTP_PASS, não SMTP_PASSWORD.
SMTP_PASS=
# Remetente exibido na mensagem de teste (o serviço lê EMAIL_REMETENTE,
# não SMTP_FROM). Não precisa ser o usuário SMTP fornecido pelo Mailtrap.
EMAIL_REMETENTE=no-reply@ethreads.local
# Endereço do frontend incluído nos links de ativação e redefinição.
# Em testes em outro dispositivo, localhost deve ser trocado pelo endereço
# pelo qual esse dispositivo acessa o frontend.
FRONT_URL=http://localhost:5173
# Para entrega real em produção, configure um provedor de envio real;
# a configuração de Email Sandbox acima serve apenas para testes.
